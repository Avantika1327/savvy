generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// SaaS platform / tenant administration
// -----------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  INACTIVE
  PAYMENT_PENDING
  SUSPENDED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipRole {
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  STAFF
}

enum TenantModule {
  PLANTS
  DRIVERS
  CUSTOMERS
  VENDORS
  DISTRIBUTORS
}

enum PlantCoverageType {
  LOCAL
  PAN_INDIA
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  SUSPENDED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  GATEWAY
  BANK_TRANSFER
  UPI
  CASH
  CARD
  OTHER
}

model Tenant {
  id                     String       @id @default(cuid())
  name                   String
  slug                   String       @unique
  contactName            String?      @map("contact_name")
  contactEmail           String?      @map("contact_email")
  contactPhone           String?      @map("contact_phone")
  contactPhoneNormalized String?      @unique(map: "tenants_contact_phone_normalized_key") @map("contact_phone_normalized")
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamp(3)
  status                 TenantStatus @default(TRIAL)
  activatedAt            DateTime?    @map("activated_at") @db.Timestamp(3)
  deactivatedAt          DateTime?    @map("deactivated_at") @db.Timestamp(3)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  memberships                      TenantMembership[]
  moduleAccess                     TenantModuleAccess[]
  rolePermissions                  TenantRolePermission[]
  subscription                     Subscription?
  payments                         Payment[]
  auditLogs                        AuditLog[]
  plants                           Plant[]
  plantManagerInvitations          PlantManagerInvitation[]
  products                         Product[]
  customers                        Customer[]
  drivers                          Driver[]
  routes                           Route[]
  contracts                        Contract[]
  orders                           Order[]
  shippingAddresses                ShippingAddress[]
  shippingContacts                 ShippingContact[]
  shippingContactMultiples         ShippingContactsMultiple[]
  machineDispensaries              MachineDispensary[]
  maintenances                     Maintenance[]
  vendors                          Vendor[]
  reasons                          Reason[]
  rawMaterials                     RawMaterial[]
  rawMaterialVariants              RawMaterialVariant[]
  rawStockTransactions             RawStockTransaction[]
  rawDistributions                 RawDistribution[]
  rawStockLogs                     RawStockLog[]
  rawStockForPlants                RawStockForPlant[]
  plantProductions                 PlantProduction[]
  plantProductionDetails           PlantProductionDetail[]
  jarTransportations               JarTransportation[]
  jarMaintenances                  JarMaintenance[]
  jarTransportLogs                 JarTransportLog[]
  jarTransportDriverLogs           JarTransportDriverLog[]
  digitalCards                     DigitalCard[]
  labReports                       LabReport[]
  distributors                     Distributor[]
  distributorPlantOrders           DistributorPlantOrder[]
  distributorPlantProductions      DistributorPlantProduction[]
  distributorPlantDispatches       DistributorPlantDispatch[]
  distributorPlantOrderAcceptances DistributorPlantOrderAcceptance[]
  distributorPlantInventories      DistributorPlantInventory[]
  distributorPlantAllocations      DistributorPlantAllocation[]
  orderGenerationFailures          OrderGenerationFailure[]
  scrabJars                        ScrabJar[]

  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
  @@map("tenants")
}

model Subscription {
  id                    String             @id @default(cuid())
  tenantId              String             @unique @map("tenant_id")
  planCode              String             @default("STARTER") @map("plan_code")
  status                SubscriptionStatus @default(TRIAL)
  billingCycle          BillingCycle       @default(MONTHLY) @map("billing_cycle")
  priceAmount           Decimal?           @map("price_amount") @db.Decimal(10, 2)
  currency              String             @default("INR")
  startsAt              DateTime           @default(now()) @map("starts_at") @db.Timestamp(3)
  trialEndsAt           DateTime?          @map("trial_ends_at") @db.Timestamp(3)
  currentPeriodStartsAt DateTime?          @map("current_period_starts_at") @db.Timestamp(3)
  currentPeriodEndsAt   DateTime?          @map("current_period_ends_at") @db.Timestamp(3)
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamp(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([id, tenantId])
  @@index([status, currentPeriodEndsAt])
  @@map("subscriptions")
}

model TenantMembership {
  id        String         @id @default(cuid())
  userId    Int            @map("user_id")
  tenantId  String         @map("tenant_id")
  role      MembershipRole @default(STAFF)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, isActive])
  @@map("tenant_memberships")
}

model TenantModuleAccess {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  module    TenantModule
  isEnabled Boolean      @default(true) @map("is_enabled")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@index([module, isEnabled])
  @@map("tenant_module_access")
}

model TenantRolePermission {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  role      MembershipRole
  module    TenantModule
  canView   Boolean        @default(true) @map("can_view")
  canCreate Boolean        @default(false) @map("can_create")
  canEdit   Boolean        @default(false) @map("can_edit")
  canDelete Boolean        @default(false) @map("can_delete")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, module])
  @@index([tenantId, role])
  @@map("tenant_role_permissions")
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String        @map("tenant_id")
  subscriptionId    String        @map("subscription_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(MANUAL)
  reference         String?
  notes             String?
  createdByUserId   Int           @map("created_by_user_id")
  confirmedByUserId Int?          @map("confirmed_by_user_id")
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamp(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy    User         @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy  User?        @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reference], map: "payments_tenant_id_reference_key")
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("payments")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId Int?     @map("actor_user_id")
  tenantId    String?  @map("tenant_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Identity. email remains globally unique so one identity can join multiple
// tenant memberships. The legacy role string is retained during migration.
// -----------------------------------------------------------------------------

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamp(3)
  password        String
  role            String       @default("client")
  platformRole    PlatformRole @default(USER) @map("platform_role")
  rememberToken   String?      @map("remember_token")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)

  memberships                    TenantMembership[]
  vendors                        Vendor[]
  managedPlants                  Plant[]                  @relation("PlantManager")
  createdPlantManagerInvitations PlantManagerInvitation[] @relation("PlantManagerInvitationCreator")
  rawStockLogs                   RawStockLog[]
  uploadedLabReports             LabReport[]              @relation("LabReportUploader")
  createdPayments                Payment[]                @relation("PaymentCreatedBy")
  confirmedPayments              Payment[]                @relation("PaymentConfirmedBy")
  auditLogs                      AuditLog[]               @relation("AuditActor")

  @@map("users")
}

// -----------------------------------------------------------------------------
// Tenant-scoped operations. tenantId is intentionally present on every business
// record, even where ownership can be inferred through Plant/Customer/Order.
// Backend queries must still apply tenant scope to every read/write.
// -----------------------------------------------------------------------------

model Plant {
  id             Int               @id @default(autoincrement())
  tenantId       String            @map("tenant_id")
  name           String
  normalizedName String            @map("normalized_name")
  address        String?
  manager        String?
  managerEmail   String?           @map("manager_email")
  coverageType   PlantCoverageType @default(LOCAL) @map("coverage_type")
  managerId      Int?              @map("manager_id")
  location       String?
  pincode        String?
  details        String?
  vendorId       Int?              @map("vendor_id")
  isActive       Boolean           @default(true) @map("is_active")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamp(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  managerRecord               User?                        @relation("PlantManager", fields: [managerId], references: [id], onDelete: Cascade)
  managerInvitations          PlantManagerInvitation[]
  vendor                      Vendor?                      @relation("PlantVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  routes                      Route[]
  drivers                     Driver[]
  shippingAddresses           ShippingAddress[]
  rawDistributions            RawDistribution[]
  rawStockLogs                RawStockLog[]
  rawStockForPlants           RawStockForPlant[]
  plantProductions            PlantProduction[]
  jarTransportations          JarTransportation[]
  jarMaintenances             JarMaintenance[]
  scrabJars                   ScrabJar[]
  distributorPlantOrders      DistributorPlantOrder[]
  distributorPlantInventories DistributorPlantInventory[]
  distributorPlantAllocations DistributorPlantAllocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive, deletedAt])
  @@index([tenantId, vendorId])
  @@map("plants")
}

model PlantManagerInvitation {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  plantId         Int       @map("plant_id")
  managerName     String    @map("manager_name")
  email           String
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamp(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamp(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamp(3)
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plant     Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PlantManagerInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, plantId, expiresAt])
  @@index([email, expiresAt])
  @@map("plant_manager_invitations")
}

model Product {
  id          Int       @id @default(autoincrement())
  tenantId    String    @map("tenant_id")
  name        String
  code        String
  price       String?
  description String?
  image       String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contracts Contract[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("products")
}

model Customer {
  id             Int       @id @default(autoincrement())
  tenantId       String    @map("tenant_id")
  customerZohoId String    @map("customer_zohi_id")
  name           String
  email          String?
  phoneNo        String?   @map("phone_no")
  billingAddress String    @map("billing_address")
  billingCountry String    @map("billing_country")
  billingState   String?   @map("billing_state")
  billingCity    String    @map("billing_city")
  billingPincode String    @map("billing_pincode")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contracts               Contract[]
  orders                  Order[]
  shippingAddresses       ShippingAddress[]
  shippingContacts        ShippingContact[]
  machineDispensaries     MachineDispensary[]
  orderGenerationFailures OrderGenerationFailure[]

  @@unique([id, tenantId])
  @@unique([tenantId, customerZohoId])
  @@unique([tenantId, email])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("customers")
}

model Contract {
  id                  Int       @id @default(autoincrement())
  tenantId            String    @map("tenant_id")
  type                String    @default("contracts")
  customerId          Int       @map("customer_id")
  productId           Int       @map("product_id")
  quantity            Int
  price               Int
  duration            Int?
  durationType        String    @default("months") @map("duration_type")
  date                DateTime? @db.Date
  frequency           String    @default("monthly")
  frequencyCount      String?   @map("frequency_count")
  days                String?
  status              String    @default("active")
  sendBy              Int?      @map("send_by")
  acceptedStatus      String?   @map("accepted_status")
  shippingAddressesId Int?      @map("shipping_addresses_id")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant                         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer                       Customer                 @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product                        Product                  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sender                         ShippingContact?         @relation("ContractSender", fields: [sendBy], references: [id], onDelete: Cascade)
  shippingAddressRef             ShippingAddress?         @relation("ContractShippingAddress", fields: [shippingAddressesId], references: [id], onDelete: Cascade)
  shippingAddressesViaContractId ShippingAddress[]        @relation("ShippingAddressContract")
  orders                         Order[]
  orderGenerationFailures        OrderGenerationFailure[]

  @@unique([id, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@map("contracts")
}

model Order {
  id               Int       @id @default(autoincrement())
  tenantId         String    @map("tenant_id")
  shippingId       Int?      @map("shipping_id")
  customerId       Int       @map("customer_id")
  contractId       Int?      @map("contract_id")
  driverId         Int?      @map("driver_id")
  routeId          Int?      @map("route_id")
  status           String    @default("pending")
  deliveredQty     String?   @default("0") @map("develivered_qty")
  returnQty        String?   @default("0") @map("return_qty")
  deliveredCardImg String?   @map("delevered_card_img")
  returnCardImg    String?   @map("return_card_img")
  type             String    @default("contracts")
  inProgressAt     DateTime? @map("in_progress_at") @db.Timestamp(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contract        Contract?        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shippingAddress ShippingAddress? @relation(fields: [shippingId], references: [id], onDelete: Cascade)
  route           Route?           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  digitalCards    DigitalCard[]

  @@unique([id, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model Route {
  id        Int       @id @default(autoincrement())
  tenantId  String    @map("tenant_id")
  plantId   Int?      @map("plant_id")
  vendorId  Int?      @map("vendor_id")
  name      String
  path      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant             Plant?            @relation(fields: [plantId], references: [id], onDelete: Cascade)
  vendor            Vendor?           @relation("RouteVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  drivers           Driver[]
  shippingAddresses ShippingAddress[]
  orders            Order[]

  @@unique([id, tenantId])
  @@index([tenantId, plantId])
  @@index([tenantId, vendorId])
  @@map("routes")
}

model Driver {
  id             Int       @id @default(autoincrement())
  tenantId       String    @map("tenant_id")
  plantId        Int?      @map("plant_id")
  routeId        Int?      @map("route_id")
  routePath      String?   @map("route_path")
  vendorId       Int?      @map("vendor_id")
  name           String
  email          String
  phoneNo        String    @map("phone_no")
  fullAddress    String    @map("full_address")
  country        String
  state          String
  city           String
  pincode        String
  licenseNo      String?   @map("license_no")
  vehicleNo      String?   @map("vehicle_no")
  vehicleName    String?   @map("vehicle_name")
  panCard        String?   @map("pan_card")
  aadharCard     String?   @map("aadhar_card")
  panCardFile    String?   @map("pan_card_FILE")
  aadharCardFile String?   @map("aadhar_card_FILE")
  otp            String?
  otpExpiresAt   DateTime? @map("otp_expires_at") @db.Timestamp(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant                  Plant?                  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  route                  Route?                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vendor                 Vendor?                 @relation("DriverVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  orders                 Order[]
  shippingAddresses      ShippingAddress[]
  maintenances           Maintenance[]
  jarTransportations     JarTransportation[]
  jarMaintenances        JarMaintenance[]
  jarTransportDriverLogs JarTransportDriverLog[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId, plantId])
  @@index([tenantId, routeId])
  @@index([tenantId, vendorId])
  @@index([tenantId, deletedAt])
  @@map("drivers")
}

model Maintenance {
  id          Int       @id @default(autoincrement())
  tenantId    String    @map("tenant_id")
  driverId    Int       @map("driver_id")
  type        String
  description String?
  amount      String
  image       String?
  status      String    @default("pending")
  date        String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, driverId])
  @@index([tenantId, status])
  @@map("maintenances")
}

model ShippingAddress {
  id                  Int       @id @default(autoincrement())
  tenantId            String    @map("tenant_id")
  customerId          Int?      @map("customer_id")
  contractId          Int?      @map("contract_id")
  plantId             Int?      @map("plant_id")
  routeId             Int?      @map("route_id")
  driverId            Int?      @map("driver_id")
  vendorId            Int?      @map("vendor_id")
  type                String?   @default("local")
  shippingAddress     String?   @map("shipping_address")
  email               String?
  shippingCountry     String?   @map("shipping_country")
  shippingState       String?   @map("shipping_state")
  shippingCity        String?   @map("shipping_city")
  shippingPincode     String?   @map("shipping_pincode")
  machineDeployed     String    @default("No") @map("machine_deployed")
  machineDeployedDate DateTime? @map("machine_deployed_date") @db.Date
  poNo                String?   @map("po_no")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant                  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer                Customer?                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contract                Contract?                  @relation("ShippingAddressContract", fields: [contractId], references: [id], onDelete: Cascade)
  referencedByContracts   Contract[]                 @relation("ContractShippingAddress")
  plant                   Plant?                     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  route                   Route?                     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver                  Driver?                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vendor                  Vendor?                    @relation("ShippingAddressVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  contactLinks            ShippingContactsMultiple[]
  machineDispensaries     MachineDispensary[]
  orders                  Order[]
  orderGenerationFailures OrderGenerationFailure[]

  @@unique([id, tenantId])
