generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  INACTIVE
  PAYMENT_PENDING
  SUSPENDED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MembershipRole {
  TENANT_OWNER
  TENANT_ADMIN
  MANAGER
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_PENDING
  SUSPENDED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  GATEWAY
  BANK_TRANSFER
  UPI
  CASH
  CARD
  OTHER
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  contactName   String?      @map("contact_name")
  contactEmail  String?      @map("contact_email")
  contactPhone  String?      @map("contact_phone")
  status        TenantStatus @default(TRIAL)
  activatedAt   DateTime?    @map("activated_at") @db.Timestamp(3)
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamp(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamp(3)
  memberships   TenantMembership[]
  plants        Plant[]
  subscription  Subscription?
  payments      Payment[]
  auditLogs     AuditLog[]

  @@index([status, createdAt])
  @@map("tenants")
}

model Subscription {
  id                    String             @id @default(cuid())
  tenantId              String             @unique @map("tenant_id")
  planCode              String             @default("STARTER") @map("plan_code")
  status                SubscriptionStatus @default(TRIAL)
  billingCycle          BillingCycle       @default(MONTHLY) @map("billing_cycle")
  priceAmount           Decimal?           @map("price_amount") @db.Decimal(10, 2)
  currency              String             @default("INR")
  startsAt              DateTime           @default(now()) @map("starts_at") @db.Timestamp(3)
  trialEndsAt           DateTime?          @map("trial_ends_at") @db.Timestamp(3)
  currentPeriodStartsAt DateTime?           @map("current_period_starts_at") @db.Timestamp(3)
  currentPeriodEndsAt   DateTime?           @map("current_period_ends_at") @db.Timestamp(3)
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamp(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamp(3)
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments              Payment[]

  @@unique([id, tenantId])
  @@index([status, currentPeriodEndsAt])
  @@map("subscriptions")
}

model TenantMembership {
  id        String         @id @default(cuid())
  userId    Int            @map("user_id")
  tenantId  String         @map("tenant_id")
  role      MembershipRole @default(STAFF)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, isActive])
  @@map("tenant_memberships")
}

model Plant {
  id        Int       @id @default(autoincrement())
  tenantId  String    @map("tenant_id")
  name      String
  address   String?
  manager   String?
  location  String?
  pincode   String?
  details   String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("plants")
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String        @map("tenant_id")
  subscriptionId    String        @map("subscription_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(MANUAL)
  reference         String?
  notes             String?
  createdByUserId   Int           @map("created_by_user_id")
  confirmedByUserId Int?          @map("confirmed_by_user_id")
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamp(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription      Subscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy         User          @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy       User?         @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId Int?    @map("actor_user_id")
  tenantId   String?  @map("tenant_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  actor      User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  emailVerifiedAt  DateTime?         @map("email_verified_at") @db.Timestamp(3)
  password         String
  // Retained for legacy application compatibility. platformRole and membership.role control new SaaS authorization.
  role             String            @default("client")
  platformRole     PlatformRole      @default(USER) @map("platform_role")
  rememberToken    String?           @map("remember_token")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)
  memberships      TenantMembership[]
  createdPayments  Payment[]         @relation("PaymentCreatedBy")
  confirmedPayments Payment[]        @relation("PaymentConfirmedBy")
  auditLogs        AuditLog[]         @relation("AuditActor")

  @@map("users")
}
