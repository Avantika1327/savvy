  order  DistributorPlantOrder @relation(fields: [distributorPlantOrdersId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, distributorPlantOrdersId])
  @@map("distributor_plant_order_acceptances")
}

model DistributorPlantInventory {
  id                  Int      @id @default(autoincrement())
  tenantId            String   @map("tenant_id")
  plantId             Int      @map("plant_id")
  distributorId       Int      @map("distributor_id")
  emptyJars           Int      @default(0) @map("empty_jars")
  filledUnlabeledJars Int      @default(0) @map("filled_unlabeled_jars")
  labeledJars         Json?    @map("labeled_jars")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant       Plant       @relation(fields: [plantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, plantId, distributorId])
  @@index([tenantId, distributorId])
  @@map("distributor_plant_inventories")
}

model DistributorPlantAllocation {
  id            Int      @id @default(autoincrement())
  tenantId      String   @map("tenant_id")
  distributorId Int      @map("distributor_id")
  plantId       Int      @map("plant_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  distributor Distributor @relation(fields: [distributorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  plant       Plant       @relation(fields: [plantId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([distributorId, plantId], map: "distributor_plant_unique")
  @@index([tenantId, plantId])
  @@map("distributor_plant_allocations")
}

model OrderGenerationFailure {
  id          Int      @id @default(autoincrement())
  tenantId    String   @map("tenant_id")
  contractId  Int?     @map("contract_id")
  customerId  Int?     @map("customer_id")
  shippingId  Int?     @map("shipping_id")
  failureDate DateTime @map("failure_date") @db.Date
  source      String   @default("contract_scheduler")
  reason      String
  details     String?
  attemptedAt DateTime @map("attempted_at") @db.Timestamp(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shipping ShippingAddress? @relation(fields: [shippingId], references: [id], onDelete: SetNull)

  @@index([tenantId, failureDate, source])
  @@index([tenantId, contractId])
  @@index([tenantId, customerId])
  @@map("order_generation_failures")
}

model ScrabJar {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  plantId   Int      @map("plant_id")
  qty       String
  amount    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant  Plant  @relation(fields: [plantId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, plantId, createdAt])
  @@map("scrab_jars")
}

// App release metadata applies across tenants and therefore stays platform-wide.
model AppVersion {
  id                  Int      @id @default(autoincrement())
  target              String   @map("for")
  platform            String
  latestVersion       String   @map("latest_version")
  minSupportedVersion String   @map("min_supported_version")
  storeUrl            String   @map("store_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  @@index([target, platform])
  @@map("app_versions")
}

// -----------------------------------------------------------------------------
// Legacy Laravel infrastructure tables from database.zip.
// These are retained for source-schema coverage. A Node-only deployment may
// choose not to use/migrate Laravel-specific password reset or Sanctum tokens.
// -----------------------------------------------------------------------------

model PasswordResetToken {
  email     String    @id
  token     String
  createdAt DateTime? @map("created_at") @db.Timestamp(3)

  @@map("password_reset_tokens")
}

/// Legacy compatibility table. The supplied migration has no primary key or
/// unique constraint, so Prisma cannot expose CRUD for it safely. Keep ignored
/// unless a deliberate migration adds a stable unique identifier.
model PasswordReset {
  email     String
  token     String
  createdAt DateTime? @map("created_at") @db.Timestamp(3)

  @@index([email], map: "password_resets_email_index")
  @@map("password_resets")
  @@ignore
}

model FailedJob {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failedAt   DateTime @default(now()) @map("failed_at") @db.Timestamp(3)

  @@map("failed_jobs")
}

/// Legacy Laravel Sanctum polymorphic token table. tokenableType/tokenableId
/// intentionally have no Prisma relation because tokenable is polymorphic.
model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement())
  tokenableType String    @map("tokenable_type")
  tokenableId   BigInt    @map("tokenable_id")
  name          String
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(3)
  expiresAt     DateTime? @map("expires_at") @db.Timestamp(3)
  createdAt     DateTime? @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(3)

  @@index([tokenableType, tokenableId], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
  @@map("personal_access_tokens")
}
