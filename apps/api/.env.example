PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/savvy?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=savvy-api
JWT_AUDIENCE=savvy-clients
# Used only by the seed command to create the initial platform owner.
SUPER_ADMIN_NAME=Savvy Platform Admin
SUPER_ADMIN_EMAIL=platform-admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-UNIQUE-PASSWORD
